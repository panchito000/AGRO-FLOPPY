{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/api", "destination": "/api/index.py" },
    { "source": "/((?!api/)(?!css/)(?!js/)(?!assets/).*)", "destination": "/index.html" }
  ],
  "env": {
    "APP_ENV": "production",
    "ROOT_PATH": "/api"
  }
}
